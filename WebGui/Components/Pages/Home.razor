@page "/"

<div class="row mt-5">
        <div class="col-2"></div>
        <div class="col-8 text-center">
            <h1 class="fw-bold text-white">Wilkommen bei Tres!</h1>
        </div>
        <div class="col-2"></div>
    </div>
    <div class="row mb-5 mt-1">
        <div class="col-2"></div>
        <div class="col-8 text-center">
            <p class="fw-bold text-white">Spaß und Spiel für Freunde und Familie!</p>
        </div>
        <div class="col-2"></div>
    </div>
    <div class="row mb-5 mt-5 mb-5" >
        <div class="col-4"></div>
        <div class="col-2">
            <a type="button" class="btn">
                <div class="card" style="width: 18rem;">
                    <img src="img/Login.png" class="card-img-top w-25 m-auto mt-3" alt="Login">
                    <div class="card-body">
                        <h5 class="card-title fs-4 fw-semibold">Login</h5>
                        <p class="card-text">Einloggen und Starten</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-2">
            <a type="button" class="btn">
                <div class="card" style="width: 18rem;">
                    <img src="img/game.jpg" class="card-img-top w-25 m-auto mt-3" alt="Login">
                    <div class="card-body">
                        <h5 class="card-title fs-4 fw-semibold">Spielen</h5>
                        <p class="card-text">Neues Spiel starten</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-4"></div>
    </div>
<div class="row" style="margin-top: 4rem"> 
    <div class="col-4"></div>
    <div class="col-4 d-flex justify-content-around">
        <img class="letter_card" style="@($"rotate:{@RotationYellow}deg")" src="img/CardT.svg" alt="Yellow T">
        <img class="letter_card" style="@($"rotate:{@RotationRed}deg")" src="img/RotRTres.svg" alt="Red R">
        <img class="letter_card" style="@($"rotate:{@RotationBlue}deg")" src="img/BlueETres.svg" alt="Blue E">
        <img class="letter_card" style="@($"rotate:{@RotationGreen}deg")" src="img/GreenS.svg" alt="Green S">
    </div>
    <div class="col-4"></div>
</div>
<script>
    const elements = document.querySelectorAll('.letter_card');
    let angle = 0;

    function animate() {
        angle += 1;

        elements.forEach(element => {
            element.style.transform = `rotate(${angle}deg)`;
        });
        requestAnimationFrame(animate);
    }
    animate();
</script>
@code {
    public int RotationRed { get; set; }
    public int RotationYellow { get; set; }
    public int RotationGreen { get; set; }
    public int RotationBlue { get; set; }

    protected override void OnInitialized()
    {
        Random rnd =  new Random();
        
        RotationRed = rnd.Next(-90, 90);
        RotationYellow = rnd.Next(-90, 90);
        RotationGreen = rnd.Next(-90, 90);
        RotationBlue = rnd.Next(-90, 90);
    }
}