@page "/"

    <div class="row mt-5">
        <div class="col-2"></div>
        <div class="col-8 text-center">
            <h1 class="fw-bold text-white">Wilkommen bei Tres!</h1>
        </div>
        <div class="col-2"></div>
    </div>
    <div class="row mb-5 mt-1">
        <div class="col-2"></div>
        <div class="col-8 text-center">
            <p class="fw-bold text-white">Spaß und Spiel für Freunde und Familie!</p>
        </div>
        <div class="col-2"></div>
    </div>
    <div class="row mb-5 mt-5" >
        <div class="col-3"></div>
        <div class="col-2">
            <a type="button" class="btn">
                <div class="card" style="width: 18rem;">
                    <img src="img/Login.png" class="card-img-top w-25 m-auto mt-3" alt="Login">
                    <div class="card-body">
                        <h5 class="card-title fs-4 fw-semibold">Login</h5>
                        <p class="card-text">Einloggen und Starten</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-2">
            <a type="button" class="btn">
                <div class="card" style="width: 18rem;">
                    <img src="img/game.jpg" class="card-img-top w-25 m-auto mt-3" alt="Login">
                    <div class="card-body">
                        <h5 class="card-title fs-4 fw-semibold">Spielen</h5>
                        <p class="card-text">Neues Spiel starten</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-2">
            <a type="button" class="btn">
                <div class="card" style="width: 18rem;">
                    <img src="img/stats.jpg" class="card-img-top w-25 m-auto mt-3" alt="Login">
                    <div class="card-body">
                        <h5 class="card-title fs-4 fw-semibold">Statistiken</h5>
                        <p class="card-text">Infos über deine Spiele</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-3"></div>
    </div>
    <div class="row mt-5">
        <div class="col-4"></div>
        <div class="col-4">
            <div class="d-flex flex-column">
            </div>
        </div>
        <div class="col-4"></div>
    </div>

@code {
    
}