@page "/passwordreset"
@using Domain.Core
@using Domain.Repositories.Interface
@using Model.Entities
@inject NavigationManager NavManager
@inject IRepository<User> _userRepository
@inject IPasswordHasher _passwordHasher

@rendermode InteractiveServer

<EditForm Model="@ForgottenUser" OnValidSubmit="@HandleValidSubmit">
    <ValidationSummary></ValidationSummary>
    <DataAnnotationsValidator/>
    <div class="container mt-4 mb-4 d-flex justify-content-center ">
        <div class="col-5 justify-content-center d-flex">
            <div class="card rounded-5 " style="width: 100%;">
                <div style="height: auto; width: auto" class="mt-4 d-flex  align-items-center align-content-center justify-content-center">
                    <img src="./image/LoginPFP.svg" class=" rounded-4" alt="...">
                </div>
                <div class="card-body d-flex justify-content-center flex-column">
                    <div class="mb-4 d-flex justify-content-center flex-column align-content-center align-items-center">
                        <h2>Passwort vergessen?</h2>
                        <h5>Setze es heir nun zurück!</h5>
                    </div>
                    <div class="mb-4 mx-5">
                        <label for="">Altes Password</label>
                        <InputText style="height: 2.5rem"  type="password" class="form-control rounded-4" @bind-Value="ForgottenUser.OldPassword"/>
                        <ValidationMessage For="@(() => ForgottenUser.OldPassword)"/>
                    </div>
                    <div class="mb-4 mx-5">
                        <label for="">Neues Password</label>
                        <InputText style="height: 2.5rem"  type="password" class="form-control rounded-4" @bind-Value="ForgottenUser.NewPassword"/>
                        <ValidationMessage For="@(() => ForgottenUser.NewPassword)"/>
                    </div>
                    @if (ErrorMessage is not null)
                    {
                        <span>@ErrorMessage</span>
                    }
                    <div class="mb-4 mx-5">
                        <button style="height: 2.5rem" class="w-100 rounded-4 text-white" type="submit">Password zurücksetzen</button>
                    </div>
                    <div class="d-flex justify-content-center">
                        <a class="text-decoration-none text-secondary" href="/"><h5 class="fw-bold">&#8592 Zurück zur Startseite</h5></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</EditForm>
@code {
    private ForgottenPassword ForgottenUser { get; set; } = new();
    private string ErrorMessage { get; set; } = String.Empty;

    private void HandleValidSubmit()
    {
        List<User> oldUsers = _userRepository.GetAll().Where(user => CurrentUser.getInstance().Email.Equals(user.Email) && _passwordHasher.Verify(ForgottenUser.OldPassword, user.Password)).ToList();
        if (oldUsers.Count > 0)
        {
            CurrentUser.getInstance().Name = oldUsers[0].Name;
            CurrentUser.getInstance().Stats = oldUsers[0].Stats;
            CurrentUser.getInstance().Password = _passwordHasher.Hash(ForgottenUser.NewPassword);
            _userRepository.Delete(oldUsers[0]);
            _userRepository.Create(CurrentUser.getInstance());
            NavManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Falsches Passwort! Bitte geben Sie ihr altes Passwort ein!";
        } 
    }
}