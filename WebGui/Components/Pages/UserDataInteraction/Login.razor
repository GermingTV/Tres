@page "/login"
@using Domain.Core
@using Domain.Repositories.Interface
@using Microsoft.AspNetCore.Identity
@using Model.Entities
@inject IRepository<User> _userRepository
@inject IPasswordHasher _passwordHasher
@inject NavigationManager NavManger
@rendermode InteractiveServer

        <EditForm Model="@NewUser" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator/>
            <div class="container d-flex justify-content-center ">
                <div class="col-6 justify-content-center d-flex">
                    <div class="card rounded-5 " style="width: 100%;">
                        <div style="height: auto; width: auto" class="mt-5 d-flex  align-items-center align-content-center justify-content-center">
                            <img  src="./image/LoginPFP.svg" class=" rounded-4" alt="...">
                        </div>
                        <div class="card-body d-flex justify-content-center flex-column">
                            <div class="mb-4 d-flex justify-content-center flex-column align-content-center align-items-center">
                                <h1>Wilkommen zurück!</h1>
                                <h5>Melde dich an, um weiter zu spielen</h5>
                            </div>
                            <div class="mb-4 mx-5">
                                <label for="">Username</label>
                                <InputText style="height: 3.5rem" required class="form-control rounded-4" @bind-Value="NewUser.Name"/>
                                <ValidationMessage For="@(() => NewUser.Name)"/>
                            </div>
                            <div class=" mb-4 mx-5">
                                <label for="">Email</label>
                                <InputText type="email" style="height: 3.5rem" required class="form-control rounded-4" @bind-Value="NewUser.Email"/>
                                <ValidationMessage For="@(() => NewUser.Email)"/>
                            </div>
                            <div class="mb-4 mx-5">
                                <label for="">Password</label>
                                <InputText style="height: 3.5rem" required type="password" class="form-control rounded-4" @bind-Value="NewUser.Password"/>
                                <ValidationMessage For="@(() => NewUser.Password)"/>
                            </div>
                            @if (ErrorMessage is not null)
                            {
                                <span>@ErrorMessage</span>
                            }
                            <div class="mb-4 mx-5">
                                <a class="text-decoration-none" href="/forgetpassword">Passowort vergessen?</a>
                            </div>
                            <div style="height: 3.5rem" class="mb-4 mx-5">
                                <button class="w-100 h-100 rounded-4" type="submit">Anmelden</button>
                            </div>
                            <div class="d-flex justify-content-center mb-5">
                                <h5>Noch kein Konto? <a class="text-decoration-none" href="/registration">Jetzt registrieren</a></h5>
                            </div>
                            <div class="d-flex justify-content-center">
                                <a class="text-decoration-none text-secondary" href="/"><h5 class="fw-bold">&#8592 Zurück zur Startseite</h5></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>


@code {
    private User NewUser = new User();
    private string? ErrorMessage = String.Empty;
    private void HandleValidSubmit()
    {
        List<User> matchingUsers = _userRepository.GetAll().Where(user => user.Name.Equals(NewUser.Name) && user.Email.Equals(NewUser.Email) && _passwordHasher.Verify(NewUser.Password, user.Password)).ToList();
        if (matchingUsers.Count == 0)
        {
            ErrorMessage = "User not found or passowrd is wrong!";
        }
        else
        {
            CurrentUser.getInstance().Name = matchingUsers[0].Name;
            CurrentUser.getInstance().StatsId = matchingUsers[0].StatsId;
            NavManger.NavigateTo("/");
        }
    }
}