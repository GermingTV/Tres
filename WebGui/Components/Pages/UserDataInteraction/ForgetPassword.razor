@page "/forgetpassword"
@using Domain.Core
@using Domain.Repositories.Interface
@using Model.Entities
@inject IRepository<User> _userRepository
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
<EditForm Model="@NewUser" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator/>
            <div class="container mt-4 mb-4 d-flex justify-content-center ">
                <div class="col-5 justify-content-center d-flex">
                    <div class="card rounded-5 " style="width: 100%;">
                        <div style="height: auto; width: auto" class="mt-5 d-flex  align-items-center align-content-center justify-content-center">
                            <img  src="./image/LoginPFP.svg" class=" rounded-4" alt="...">
                        </div>
                        <div class="card-body d-flex justify-content-center flex-column">
                            <div class="mb-4 d-flex justify-content-center flex-column align-content-center align-items-center">
                                <h2>Passwort zurücksetzen</h2>
                            </div>
                            <div class=" mb-4 mx-5">
                                <label for="">Email</label>
                                <InputText type="emai" style="height: 2.5rem" required class="form-control rounded-4" @bind-Value="NewUser.Email"/>
                                <ValidationMessage For="@(() => NewUser.Email)"/>
                            </div>
                            @if (ErrorMessage is not null)
                            {
                                <span>@ErrorMessage</span>
                            }
                            <div class="mb-4 mx-5">
                                <button style="height: 2.5rem" class="w-100 rounded-4 text-white" type="submit">Zurücksetzen</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <a class="text-decoration-none text-secondary" href="/"><h5 class="fw-bold">&#8592 Zurück zur Startseite</h5></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>

@code {
    private ForgottenUser NewUser = new ForgottenUser();
    private string? ErrorMessage = String.Empty;

    private void HandleValidSubmit()
    {
        List<User> matchingUsers = _userRepository.GetAll().Where(user => user.Email.Equals(NewUser.Email)).ToList();
        if (matchingUsers.Count == 0)
        {
            ErrorMessage = "Kein Nutzer mit dieser Email gefunden!";
        }
        else
        {
            CurrentUser.getInstance().Email = NewUser.Email;
            NavigationManager.NavigateTo("/passwordreset");
        }
    }

}